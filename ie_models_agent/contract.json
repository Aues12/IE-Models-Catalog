{
  "name": "inventory_models",
  "type": "tool",
  "contract_version": 1,
  "canonical_manifest": true,
  "manifest_format": "JSON-compatible YAML 1.2; parsed with the Python standard library",
  "procedure": "USE_TOOL.md",
  "capability": "deterministic_inventory_planning",
  "purpose": "Discover, solve, and compare inventory models through the existing Python library.",
  "status": "experimental",
  "deterministic": true,
  "interfaces": [
    {
      "name": "stdin_json",
      "entrypoint": "inventory_agent.py",
      "command": [
        "python",
        "-m",
        "ie_models_agent"
      ],
      "transport": "stdin_json"
    },
    {
      "name": "python_api",
      "entrypoint": "ie_models_agent/tool.py",
      "callables": [
        "run"
      ]
    }
  ],
  "execution": {
    "max_request_bytes": 1048576,
    "exit_codes": {
      "0": "success",
      "1": "request/domain validation error or infeasible plan",
      "2": "empty, malformed, oversized, duplicate-key or non-UTF-8 JSON",
      "3": "numerical or unexpected execution failure"
    }
  },
  "side_effects": {
    "reads": [
      "Bundled contract and imported library modules only."
    ],
    "writes": [],
    "network": false,
    "notes": [
      "No caller file access, plotting, process execution, or report generation. Python may create interpreter bytecode caches."
    ]
  },
  "limits": {
    "max_request_bytes": 1048576,
    "max_periods": 120,
    "max_profile_points": 1000,
    "max_discount_tiers": 256
  },
  "models": [
    {
      "id": "basic_eoq",
      "family": "eoq",
      "module": "inventory_models",
      "class": "BasicEOQ",
      "guide": "docs/models/basic_eoq.md",
      "guarantee": "exact_under_assumptions",
      "input_schema": "#/$defs/input_basic_eoq"
    },
    {
      "id": "epq",
      "family": "eoq",
      "module": "inventory_models",
      "class": "EPQ",
      "guide": "docs/models/epq.md",
      "guarantee": "exact_under_assumptions",
      "input_schema": "#/$defs/input_epq"
    },
    {
      "id": "discount_eoq",
      "family": "eoq",
      "module": "inventory_models",
      "class": "DiscountEOQ",
      "guide": "docs/models/discount_eoq.md",
      "guarantee": "exact_under_assumptions",
      "input_schema": "#/$defs/input_discount_eoq"
    },
    {
      "id": "backorder_eoq",
      "family": "eoq",
      "module": "inventory_models",
      "class": "BackorderEOQ",
      "guide": "docs/models/backorder_eoq.md",
      "guarantee": "exact_under_assumptions",
      "input_schema": "#/$defs/input_backorder_eoq"
    },
    {
      "id": "incremental_discount_eoq",
      "family": "eoq",
      "module": "inventory_models",
      "class": "IncrementalDiscountEOQ",
      "guide": "docs/models/incremental_discount_eoq.md",
      "guarantee": "exact_under_assumptions",
      "input_schema": "#/$defs/input_incremental_discount_eoq"
    },
    {
      "id": "wagner-whitin",
      "family": "dynamic",
      "module": "dynamic_models",
      "class": "DynamicLotSizing",
      "guide": "docs/models/wagner_whitin.md",
      "guarantee": "exact_under_assumptions"
    },
    {
      "id": "silver-meal",
      "family": "dynamic",
      "module": "dynamic_models",
      "class": "DynamicLotSizing",
      "guide": "docs/models/silver_meal.md",
      "guarantee": "heuristic"
    }
  ],
